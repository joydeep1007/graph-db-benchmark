# ============================================================
# .env.example — copy to .env and fill in your credentials
# NEVER commit .env to git — it is in .gitignore
# ============================================================

# ── CognoDB Cloud (free tier c0) ─────────────────────────────
# Sign up: https://console.cognodb.com/signup
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=<generated-password-shown-once>

# ── Neo4j AuraDB Free ─────────────────────────────────────────
# Sign up: https://neo4j.com/cloud/platform/aura-graph-database/
NEO4J_URI=neo4j+s://<instance>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<aura-password>

# ── Memgraph (self-hosted on Render free tier) ────────────────
# Deploy: render.com → New Web Service → Docker
# Image:  memgraph/memgraph
# Start:  --storage-mode=ON_DISK_TRANSACTIONAL --memory-limit=256
MEMGRAPH_HOST=<your-service>.onrender.com
MEMGRAPH_PORT=7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# ── ArangoDB (self-hosted on Render free tier) ─────────────────
# Image:  arangodb/arangodb:latest
# Env:    ARANGODB_OVERRIDE_DETECTED_TOTAL_MEMORY=268435456
#         ARANGO_ROOT_PASSWORD=<your-password>
ARANGODB_HOST=<your-service>.onrender.com
ARANGODB_PORT=8529
ARANGODB_USER=root
ARANGODB_PASSWORD=<your-arango-password>

# ── SurrealDB (self-hosted on Render free tier) ───────────────
# Image:  surrealdb/surrealdb:latest
# Cmd:    start --log info --user root --pass $SURREALDB_PASSWORD file:/data/pokec.db
SURREALDB_URL=ws://<your-service>.onrender.com:8000/rpc
SURREALDB_USER=root
SURREALDB_PASSWORD=<your-surreal-password>
SURREALDB_NS=bench
SURREALDB_DB=pokec
